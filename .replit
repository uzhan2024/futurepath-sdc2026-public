entrypoint = "app.py"
run = "env FUTUREPATH_DEPLOYMENT_MODE=public FUTUREPATH_AI_PROVIDER=disabled FUTUREPATH_CV_ENABLED=false .venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=5000 --server.headless=true"
modules = ["python-3.12"]

[[ports]]
localPort = 5000
externalPort = 80

[packager.features]
enabledForHosting = false

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "python deployment/public_package.py verify-root && python -m venv .venv && env -u PIP_TARGET -u PIP_USER -u PYTHONUSERBASE -u PYTHONPATH PIP_CONFIG_FILE=/dev/null .venv/bin/python -m pip install --no-user -r requirements-public.lock"]
run = ["sh", "-c", "env -u PYTHONPATH -u PYTHONUSERBASE FUTUREPATH_DEPLOYMENT_MODE=public FUTUREPATH_AI_PROVIDER=disabled FUTUREPATH_CV_ENABLED=false .venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=5000 --server.headless=true"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env FUTUREPATH_DEPLOYMENT_MODE=public FUTUREPATH_AI_PROVIDER=disabled FUTUREPATH_CV_ENABLED=false .venv/bin/python -m streamlit run app.py --server.address=0.0.0.0 --server.port=5000 --server.headless=true"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
